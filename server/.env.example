# Keep your existing database/session settings; these placeholders contain no secrets.
NODE_ENV=development
MONGO_URI=
SESSION_SECRET=
CLIENT_URL=http://localhost:5173
PORT=5000
# Local development: no trusted proxy. On Render set TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0
# Production on Render also requires:
# NODE_ENV=production
# CLIENT_URL=https://event-nexus-one.vercel.app
# Production cookies are HttpOnly; Secure; SameSite=None (cross-site frontend/API).

# Optional managed profile-photo storage. Set all three on the SERVER only.
# Without them photo previews work, but saving/removal is unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
